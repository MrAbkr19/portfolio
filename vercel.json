{
  "framework": "angular",
  "devCommand": "ng serve --port $PORT",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}